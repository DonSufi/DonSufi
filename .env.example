# Copy this file to `.env` (git-ignored) and fill in real values locally.
# For EAS builds, set the same name as a project secret instead:
#   eas secret:create --scope project --name GOOGLE_PLACES_API_KEY --value "..."

# Google Places API key for the mosque finder (src/data/mosques/mosqueClient.ts).
# Without this, the Mosques screen shows its documented "not configured" state
# rather than fabricating results. See docs/LIMITATIONS.md for setup steps.
GOOGLE_PLACES_API_KEY=
