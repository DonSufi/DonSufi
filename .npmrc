# The Expo/React Native ecosystem regularly has peer-dependency ranges that
# don't perfectly line up across packages published by different teams on
# different schedules (react-native <-> jest-expo <-> @react-native/jest-preset
# being the current example -- see docs/LIMITATIONS.md's "Testing coverage"
# section). The actual code is compatible; npm's strict peer resolution
# (default since npm 7) just can't see that. This is the standard,
# recommended setting for Expo projects so a plain `npm install` works
# without every contributor needing to remember `--legacy-peer-deps`.
legacy-peer-deps=true
